# Isaac Sim 5.1 + Isaac Lab 2.3.2 image for Piper training.
#
# The NGC Isaac Lab image already contains Isaac Sim 5.1.0, Isaac Lab 2.3.2,
# torch 2.7.0+cu128 (Blackwell/RTX 50 capable) and rsl-rl-lib 3.1.2.  This
# derivative only adds the small MJCF preprocessing dependency and makes the
# Kit cache/log directories usable by the host UID that the launcher selects.
FROM nvcr.io/nvidia/isaac-lab:2.3.2

ENV ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y \
    PYTHONUNBUFFERED=1 \
    ISAACLAB_PATH=/workspace/isaaclab

# MuJoCo is used only at asset-build time: it compiles the Menagerie MJCF so
# the mesh-fitted collision capsules can be written as explicit primitives
# before Isaac Sim's MJCF importer sees the file.  It never steps physics.
COPY requirements-isaac.txt /tmp/requirements-isaac.txt
RUN /workspace/isaaclab/isaaclab.sh -p -m pip install --no-cache-dir -r /tmp/requirements-isaac.txt \
    && rm -f /tmp/requirements-isaac.txt

# The launcher runs as the host UID so runs/ and .cache/ stay user-owned.  Kit
# writes caches and logs inside the Isaac Sim tree; the launcher bind-mounts
# persistent project directories over the cache paths, and the remaining
# writable paths are opened here.  The NGC image ships /isaac-sim as 0750
# (owner uid 1234), which would hide python.sh from any other UID.
RUN chmod a+rx /isaac-sim \
    && mkdir -p /isaac-sim/kit/cache /isaac-sim/kit/logs /isaac-sim/kit/data \
    && chmod -R a+rwX /isaac-sim/kit/cache /isaac-sim/kit/logs /isaac-sim/kit/data \
    && chmod a+rwX /workspace/isaaclab

WORKDIR /workspace/piper_sim2real
ENTRYPOINT []
CMD ["/workspace/isaaclab/isaaclab.sh", "-p", "--version"]
